DATABASE_URL=postgresql://lpg:lpg@localhost:5432/lpg
NUXT_APP_ORIGIN=http://localhost:3000
NUXT_SESSION_HOURS=12
# Hosting tanpa file cert (mis. Vercel): URL tanpa sslmode/sslrootcert + isi PEM di sini.
# DATABASE_CA_CERT=
# PGPOOL_MAX=3
# Isi sendiri sebelum db:seed; tidak ada password admin bawaan.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Pemilik Pangkalan

# --- Tombol login cepat (demo/UAT) ---
# Aktif otomatis saat `nuxt dev`. Di produksi nyalakan eksplisit hanya untuk demo.
# NUXT_PUBLIC_DEMO_MODE=true
# Override daftar akun demo (JSON). Default memakai akun hasil SEED_DEMO_ACCOUNTS.
# NUXT_PUBLIC_DEMO_ACCOUNTS=[{"label":"Admin","role":"admin","username":"demo_admin","password":"password-uji-123"}]
# Buat akun demo_admin, siti_karyawan, dan warung_sumber saat `npm run db:seed`.
# SEED_DEMO_ACCOUNTS=true
# SEED_DEMO_PASSWORD=password-uji-123
