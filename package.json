{
  "name": "lpg3kgs-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "h3": "^1.15.4",
    "nuxt": "4.6.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.2.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@types/estree": "1.0.9"
  }
}
